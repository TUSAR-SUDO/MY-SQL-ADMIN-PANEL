{
  "name": "gamecenter-admin-backend",
  "version": "1.0.0",
  "description": "GameCenter Admin Panel - Backend API (MySQL + Prisma)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext js,json,env src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate"
  },
  "keywords": [
    "admin",
    "panel",
    "games",
    "express",
    "prisma",
    "mysql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.8.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
