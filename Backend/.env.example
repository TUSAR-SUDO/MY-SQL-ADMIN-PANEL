PORT=5000

# MySQL connection string (Prisma format)
# Local:       mysql://root:yourpassword@localhost:3306/admin_panel
# Railway:     mysql://root:password@host.railway.app:port/railway
# PlanetScale: mysql://user:password@host/dbname?sslaccept=strict
DATABASE_URL=mysql://root:yourpassword@localhost:3306/admin_panel

# Use a long, random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# DEMO MODE: when true, the panel opens without logging in (auth is bypassed).
# Keep this false for real deployments so tokens are required.
AUTH_BYPASS=false

# Sites allowed to use the ADMIN api. Empty = any origin (fine locally).
# Example: https://my-admin-panel.vercel.app
ALLOWED_ORIGINS=

# Sites allowed to read the PUBLIC game endpoint (/api/public/...).
# Empty = any origin. Comma-separate multiple games.
# Example: http://localhost:5173,https://my-game.vercel.app
ALLOWED_GAME_ORIGINS=
