# Where your API is reachable from a browser. The game needs an absolute URL
# because it runs on a different domain than the API.
#
# Local development:  http://localhost:5000
# Deployed:           https://your-api.onrender.com
#
# Vite bakes VITE_* values in at build time, so change this and rebuild.
VITE_PUBLIC_API_BASE=http://localhost:5000
